# BASE_DISTRIBUTION is used to switch between the old base distribution and distroless base images
ARG BASE_DISTRIBUTION=debug

# Version is the base image version from the TLD Makefile
ARG BASE_VERSION=latest
ARG ISTIO_BASE_REGISTRY=gcr.io/istio-release

# The following section is used as base image if BASE_DISTRIBUTION=debug
FROM ${ISTIO_BASE_REGISTRY}/base:${BASE_VERSION} AS debug

# Tetrate: istio 1.27 is EOL for base-image rebuilds (newest published base is
# 1.27-2026-04-01), so bumping BASE_VERSION cannot pick up newer Ubuntu security
# updates. Patch the affected OS packages in-build to remediate the curl/tar/gzip/
# nghttp2 CVEs reported against tetratefips images (CVE-2026-8924/8925/8927/8286/8458/
# 9547/10536, CVE-2025-45582, CVE-2026-5704, CVE-2026-41991/41992, CVE-2026-58055).
# hadolint ignore=DL3008,DL3009
RUN apt-get update && \
    apt-get install -y --only-upgrade curl libcurl4t64 tar gzip libnghttp2-14 && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# The following section is used as base image if BASE_DISTRIBUTION=distroless
FROM ${ISTIO_BASE_REGISTRY}/iptables:${BASE_VERSION} AS distroless

# This will build the final image based on either debug or distroless from above
# hadolint ignore=DL3006
FROM ${BASE_DISTRIBUTION:-debug}

WORKDIR /

ARG proxy_version
ARG SIDECAR=envoy

# Copy Envoy bootstrap templates used by pilot-agent
COPY envoy_bootstrap.json /var/lib/istio/envoy/envoy_bootstrap_tmpl.json

# Install Envoy.
ARG TARGETARCH
COPY ${TARGETARCH:-amd64}/${SIDECAR} /usr/local/bin/${SIDECAR}

# Environment variable indicating the exact proxy sha - for debugging or version-specific configs
ENV ISTIO_META_ISTIO_PROXY_SHA=$proxy_version

ARG TARGETARCH
COPY ${TARGETARCH:-amd64}/pilot-agent /usr/local/bin/pilot-agent

# The pilot-agent will bootstrap Envoy.
ENTRYPOINT ["/usr/local/bin/pilot-agent"]
